# ============================================
# AI_VAULT Brain V9 — Environment Variables
# ============================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it contains secrets.
# This file (.env.example) is safe to commit: it contains ONLY placeholders.
#

# --- Core Paths ----------------------------------------------------------
BRAIN_BASE_PATH=C:/AI_VAULT

# --- Security & Safety Gates (all disabled by default) -------------------
# BRAIN_SAFE_MODE=true overrides dev mode and forces safe operation
BRAIN_SAFE_MODE=false

# Dev endpoints (/dev, /godmode) — MUST stay false in production
BRAIN_ENABLE_UNSAFE_DEV_ENDPOINTS=false

# Chat dev mode — MUST stay false in production
BRAIN_CHAT_DEV_MODE=false

# Trading autocycle — MUST stay false until explicitly enabled
BRAIN_ENABLE_FINANCIAL_AUTOCYCLE=false

# Autonomy loop starters (all false by default for safety)
BRAIN_START_AUTONOMY=false
BRAIN_START_PROACTIVE=false
BRAIN_START_SELF_DIAGNOSTIC=false
BRAIN_START_QC_LIVE_MONITOR=false
BRAIN_WARMUP_MODEL=false

# --- Approval & Admin Tokens (leave empty or set CHANGE_ME_NOT_A_SECRET) --
BRAIN_APPROVAL_4D_DRY_GATE_TOKEN=
BRAIN_ADMIN_TOKEN=

# --- Server Binding -------------------------------------------------------
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8090

# --- LLM Provider API Keys (fill in your keys) ----------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- LLM Provider Endpoints (defaults are safe public URLs) ----------------
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_RESPONSES_API_URL=https://api.openai.com/v1/responses
CLAUDE_API_URL=https://api.anthropic.com/v1/messages
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-pro:generateContent

# --- Local Ollama ---------------------------------------------------------
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.1:8b
OLLAMA_AGENT_MODEL=deepseek-r1:14b

# --- OpenAI Codex CLI -----------------------------------------------------
OPENAI_CODEX_MODEL=gpt-5.1-codex-mini
CODEX_CLI_PATH=codex
CODEX_CLI_MODEL=gpt-5.5

# --- LLM Runtime Parameters -----------------------------------------------
LLM_TIMEOUT=240
LLM_AGENT_TIMEOUT=300
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192

# --- Trading Safety (paper-only by default) -------------------------------
# PAPER_ONLY=true means NO live trading regardless of other flags
PAPER_ONLY=true

# IBKR connectivity
IBKR_VIA_QC_CLOUD=true
IBKR_HOST=127.0.0.1
IBKR_PORT=4002

# PocketOption bridge (leave empty if not used)
POCKETOPTION_BRIDGE_URL=

# --- Ledger / Cooldown ----------------------------------------------------
MAX_LEDGER_ENTRIES=500
ACTION_COOLDOWN_SECONDS=120
PAPER_TRADE_DEFAULT_AMOUNT=10.0

# --- System Health Thresholds ---------------------------------------------
CPU_THRESHOLD_PCT=85
MEMORY_THRESHOLD_PCT=90
DISK_THRESHOLD_PCT=90

# --- Data Freshness (seconds) ---------------------------------------------
FEATURE_MAX_AGE_IBKR=900
FEATURE_MAX_AGE_DEFAULT=600

# --- Session Filtering ----------------------------------------------------
SESSION_FILTER_MODE=adaptive
SESSION_MIN_SAMPLE_FOR_BLOCK=10
SESSION_BLOCK_WIN_RATE_THRESHOLD=0.55

# --- Signal Adaptation ----------------------------------------------------
SIGNAL_THRESHOLD_MAX_SHIFT=0.15
SIGNAL_THRESHOLD_MIN_SAMPLE=10

# --- Trade Resolution -----------------------------------------------------
RESOLUTION_PRICE_THRESHOLD_PCT=0.05
BINARY_EXPIRY_MIN_RELIABLE_PCT=0.001
PENDING_TRADE_TIMEOUT_SECONDS=360

# --- Autonomy Config ------------------------------------------------------
AUTO_DEBUG=true
AUTO_OPT=true
AUTO_MONITOR=true
UTILITY_LOOP=true
DEBUG_INTERVAL=300
OPT_INTERVAL=600
MONITOR_INTERVAL=300
UTILITY_INTERVAL=120
UTILITY_MIN_RESOLVED_SAMPLE=10
PROBATION_MIN_RESOLVED_TRADES=5
RETIREMENT_FROZEN_DAYS=14
UNFREEZE_MIN_FROZEN_DAYS=3
TRADE_COOLDOWN_SECONDS=300

# --- External Data Provider Secrets (paths to JSON files) -----------------
TIINGO_SECRETS=tmp_agent/Secrets/tiingo_access.json
QC_SECRETS=tmp_agent/Secrets/quantconnect_access.json

# --- Self-Improvement External Sources ------------------------------------
GITHUB_TOKEN=
FRED_API_KEY=
