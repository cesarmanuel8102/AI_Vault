        "method": "create_run",
        "signature": "create_run(self, goal: str, mode: str = 'read_only', user_id: str = 'local') -> Dict[str, Any]",
        "description": "Create a new run, validate mode, generate run_id agv2_<hash>, persist run.json and checkpoint, return run dict"
      },
      {
        "method": "execute_run",
        "signature": "execute_run(self, run_id: str) -> Dict[str, Any]",
        "description": "Load run, assemble context, select intent route, plan/execute, finalize, persist, return completed/failed run dict"
      }
    ],
    "optional_methods": [
      {"method": "plan_run", "signature": "plan_run(self, run_id: str) -> Dict[str, Any]"},
      {"method": "pause_run", "signature": "pause_run(self, run_id: str) -> Dict[str, Any]"},
      {"method": "resume_run", "signature": "resume_run(self, run_id: str) -> Dict[str, Any]"},
      {"method": "cancel_run", "signature": "cancel_run(self, run_id: str) -> Dict[str, Any]"},
      {"method": "get_run", "signature": "get_run(self, run_id: str) -> Dict[str, Any]"},
      {"method": "get_trace", "signature": "get_trace(self, run_id: str) -> List[Dict[str, Any]]"},
      {"method": "list_runs", "signature": "list_runs(self) -> List[Dict[str, Any]]"}
    ]
  },
  "api_endpoints": {
    "chat_agent": {
      "path": "POST /v2/chat/agent",
      "auth": "require_strict_operator_access (X-Brain-Token)",
      "request_fields": {
        "message": "str (required)",
        "mode": "str (default 'read_only')",
        "user_id": "str (default 'local')"
      },
      "pipeline": [
        "validate message not empty",
        "reject forbidden bypass/override fields",
        "parse mode from natural language or request mode",
        "assemble recent context",
        "select intent route",
        "rt.create_run(message, validated_mode, user_id)",
        "if route in {mixed_brain_reasoning, operational_agent}: rt.plan_run(run_id)",
        "rt.execute_run(run_id)",
        "trace_events = rt.get_trace(run_id)",
        "build capability_metadata",
        "normalize response"
      ]
    },
    "trace": {
      "path": "GET /v2/agent/runs/{run_id}/trace",
      "auth": "require_strict_operator_access",
      "response": "{ok, run_id, trace: List[Dict], event_count}"
    },
    "run_lifecycle": {
      "create": "POST /v2/agent/runs",
      "get": "GET /v2/agent/runs/{run_id}",
      "plan": "POST /v2/agent/runs/{run_id}/plan",
      "execute": "POST /v2/agent/runs/{run_id}/execute",
      "pause": "POST /v2/agent/runs/{run_id}/pause",
      "resume": "POST /v2/agent/runs/{run_id}/resume",
      "cancel": "POST /v2/agent/runs/{run_id}/cancel"
    }
  },
  "normalized_response_schema": {
    "top_level_required": [
      "ok", "canonical_agent_v2", "route", "run_id", "final_answer",
