        },
        {
          "line": 268,
          "text": "            \"agent_tool_calls_ok\": 0,"
        },
        {
          "line": 269,
          "text": "            \"agent_tool_calls_fail\": 0,"
        },
        {
          "line": 270,
          "text": "            \"avg_latency_ms\": 0.0,"
        },
        {
          "line": 271,
          "text": "            \"ghost_completion_count\": 0,"
        },
        {
          "line": 272,
          "text": "            \"tool_markup_leak_count\": 0,"
        },
        {
          "line": 273,
          "text": "            \"canned_no_result_count\": 0,"
        },
        {
          "line": 274,
          "text": "            \"errors\": {},          # error_type -> count"
        },
        {
          "line": 275,
          "text": "            # R4.1: per-validator firings (R3/R3.1 quality guards). Lets us"
