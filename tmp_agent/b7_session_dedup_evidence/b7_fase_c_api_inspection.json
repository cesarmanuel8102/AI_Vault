          "text": "                saved = json.loads(_CHAT_METRICS_PATH.read_text(encoding=\"utf-8\"))"
        },
        {
          "line": 288,
          "text": "                for key in (\"total_conversations\", \"success\", \"failed\","
        },
        {
          "line": 289,
          "text": "                            \"agent_tool_calls_ok\", \"agent_tool_calls_fail\","
        },
        {
