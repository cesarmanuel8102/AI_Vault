        {
          "line": 1079,
          "text": "        \"\"\""
        },
        {
          "line": 1080,
          "text": "        msg_lower = (user_message or \"\").lower()"
        },
        {
          "line": 1081,
          "text": "        contradictions = []"
        },
        {
          "line": 1082,
          "text": "        warnings = []"
