          "text": "        coherence_score = 1.0"
        },
        {
          "line": 1084,
          "text": "        "
        },
        {
          "line": 1085,
          "text": "        # ── Detection 1: Domain Contradiction ─────────────────────────────────"
        },
        {
          "line": 1086,
          "text": "        # User explicitly excludes a domain but route goes there"
