        {
          "line": 252,
          "text": "class ChatMetrics:"
        },
        {
          "line": 253,
          "text": "    \"\"\"Lightweight conversation-level metrics for self-improvement impact measurement."
        },
        {
          "line": 254,
          "text": ""
        },
        {
          "line": 255,
          "text": "    Tracks per-route counts, success/failure, latency, and error types."
        },
        {
          "line": 256,
          "text": "    Persists to disk every _PERSIST_EVERY conversations so the self-improvement"
        },
