{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "common": {
      "type": "object",
      "required": ["schema_version", "decision_id", "authorization_id", "repository", "issue", "pr", "base_sha", "head_sha", "roadmap_id", "roadmap_item_id", "risk", "deterministic_gate", "codex_review", "policy_decision", "allowed_action", "policy_sha256", "evidence_sha256", "created_utc"],
      "properties": {
        "decision_id": {"type": "string", "format": "uuid"},
        "authorization_id": {"type": "string"},
        "repository": {"type": "string"},
        "issue": {"type": "integer", "minimum": 1},
        "pr": {"type": "integer", "minimum": 1},
        "base_sha": {"pattern": "^[0-9a-f]{40}$"},
        "head_sha": {"pattern": "^[0-9a-f]{40}$"},
        "roadmap_id": {"type": "string"},
        "roadmap_item_id": {"type": "string"},
        "risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "deterministic_gate": {"enum": ["PASS", "FAIL"]},
        "codex_review": {"enum": ["PASS", "CHANGES_REQUESTED", "BLOCKED"]},
        "policy_decision": {"enum": ["APPROVE", "REPAIR", "BLOCK", "ESCALATE_TO_OWNER"]},
        "allowed_action": {"enum": ["NONE", "MARK_READY", "MERGE", "REQUEST_REPAIR", "DEPLOY"]},
        "policy_sha256": {"pattern": "^[0-9a-f]{64}$"},
        "evidence_sha256": {"pattern": "^[0-9a-f]{64}$"},
        "created_utc": {"type": "string", "format": "date-time"}
      }
    }
  },
  "oneOf": [
    {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {"type": "object", "additionalProperties": false, "properties": {"schema_version": {"const": 1}, "decision_id": {}, "authorization_id": {}, "repository": {}, "issue": {}, "pr": {}, "base_sha": {}, "head_sha": {}, "roadmap_id": {}, "roadmap_item_id": {}, "risk": {}, "deterministic_gate": {}, "codex_review": {}, "policy_decision": {}, "allowed_action": {}, "policy_sha256": {}, "evidence_sha256": {}, "created_utc": {}}}
      ]
    },
    {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {"type": "object", "additionalProperties": false, "required": ["decision_key", "review_findings_count", "review_consistent"], "properties": {"schema_version": {"const": 2}, "decision_key": {"pattern": "^[0-9a-f]{64}$"}, "decision_id": {}, "authorization_id": {}, "repository": {}, "issue": {}, "pr": {}, "base_sha": {}, "head_sha": {}, "roadmap_id": {}, "roadmap_item_id": {}, "risk": {}, "deterministic_gate": {}, "codex_review": {}, "review_findings_count": {"type": "integer", "minimum": 0}, "review_consistent": {"type": "boolean"}, "policy_decision": {}, "allowed_action": {}, "policy_sha256": {}, "evidence_sha256": {}, "created_utc": {}}}
      ]
    }
  ]
}
