{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authorization_id", "repository", "roadmap_id", "roadmap_version", "roadmap_item_id", "expected_base_sha", "executor", "risk", "allowed_paths", "forbidden_paths", "acceptance", "test_commands", "deployment_allowed"],
  "properties": {
    "schema_version": {"const": 1},
    "authorization_id": {"const": "CESAR-BRAIN-101-OPERATOR-PROXY-20260722-01"},
    "repository": {"const": "cesarmanuel8102/AI_Vault"},
    "roadmap_id": {"const": "BRAIN-101"},
    "roadmap_version": {"type": "string"},
    "roadmap_item_id": {"type": "string"},
    "expected_base_sha": {"pattern": "^[0-9a-f]{40}$"},
    "executor": {"enum": ["agent_loop", "codex_control_plane"]},
    "risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "allowed_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "forbidden_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "acceptance": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "test_commands": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "deployment_allowed": {"const": false},
    "objective": {"type": "string"},
    "work_branch": {"type": "string"},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "deployment_mode": {"enum": ["NO_DEPLOY", "INSTALL_ONLY", "INSTALL_AND_RUNTIME_PILOT", "DOCUMENTATION_CLOSEOUT"]},
    "install_target": {"const": "agent_loop_worker"},
    "front_id": {"type": "string"},
    "roadmap_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "manifest_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "test_profile": {"enum": ["pilot", "roadmap-doc", "test-only"]},
    "max_executor_cycles": {"type": "integer", "minimum": 1, "maximum": 3},
    "closeout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["front_id", "objective", "work_branch", "executor", "risk", "allowed_paths", "forbidden_paths", "acceptance", "test_commands"],
      "properties": {
        "front_id": {"pattern": "^[A-Z0-9][A-Z0-9._-]{5,127}$"},
        "objective": {"type": "string", "minLength": 1},
        "work_branch": {"pattern": "^control-plane/[a-z0-9][a-z0-9._/-]{4,127}$"},
        "executor": {"enum": ["agent_loop", "codex_control_plane"]},
        "risk": {"enum": ["LOW", "MEDIUM"]},
        "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forbidden_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "acceptance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "test_commands": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "test_profile": {"enum": ["roadmap-doc", "test-only"]},
        "max_executor_cycles": {"type": "integer", "minimum": 1, "maximum": 3}
      }
    },
    "closeout_only": {"type": "boolean"}
  }
}
