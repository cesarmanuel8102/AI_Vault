{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "head_sha", "summary", "findings"],
  "properties": {
    "verdict": {"type": "string", "enum": ["PASS", "CHANGES_REQUESTED", "BLOCKED"]},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "summary": {"type": "string", "maxLength": 1200},
    "findings": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "title", "evidence", "required_correction"],
        "properties": {
          "id": {"type": "string", "maxLength": 40},
          "severity": {"type": "string", "enum": ["P0", "P1"]},
          "title": {"type": "string", "maxLength": 200},
          "evidence": {"type": "string", "maxLength": 1200},
          "required_correction": {"type": "string", "maxLength": 1200}
        }
      }
    }
  }
}

